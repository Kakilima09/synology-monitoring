# Flask
SECRET_KEY=your-secret-key-here
APP_ENV=development

# Database (SQLite default)
DATABASE_URL=sqlite:///synology_monitor.db

# For MySQL: mysql+pymysql://user:pass@localhost/dbname

# Synology Sync
SYNC_INTERVAL_MINUTES=5

# Auto-sync saat halaman Log Drive / Drive Client di-refresh
# (true/false, default true)
AUTO_SYNC_ON_VIEW=true
# Interval minimum (detik) antara trigger auto-sync, default 60
AUTO_SYNC_MIN_INTERVAL_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Optional: for real Synology API
SYNOLOGY_API_TIMEOUT=30